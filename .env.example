# ---------------------------------------------------------------------------
# BrightScope environment
# Copy to .env and fill in. Only the first two are required.
# ---------------------------------------------------------------------------

# Database. SQLite for local development:
DATABASE_URL="file:./dev.db"
# PostgreSQL for production (run `npm run db:use postgres` first):
# DATABASE_URL="postgresql://user:password@host:5432/brightscope?schema=public"

# Session cookie signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

NODE_ENV="development"
APP_URL="http://localhost:3000"
SESSION_TTL_HOURS="12"

# --- Audit engine -----------------------------------------------------------
AUDIT_USER_AGENT="BrightScopeBot/0.1 (+https://brightthoughts.example/bot; marketing audit; contact audit@brightthoughts.example)"
AUDIT_REQUEST_TIMEOUT_MS="15000"
AUDIT_MIN_INTERVAL_MS="1500"
AUDIT_MAX_REDIRECTS="10"
AUDIT_MAX_PAGES_PER_RUN="12"
AUDIT_MAX_BYTES="3000000"
AUDIT_RESPECT_ROBOTS="true"
EVIDENCE_FRESHNESS_HOURS="168"

# --- Outreach safety --------------------------------------------------------
# console = write to the outbox and activity log, contact nobody. Change only
# after deliverability and legal sign-off (docs/ASSUMPTIONS.md 4).
EMAIL_PROVIDER="console"
EMAIL_FROM_NAME="Bright Thoughts Services"
EMAIL_FROM_ADDRESS=""
EMAIL_FREQUENCY_CAP_DAYS="30"
EMAIL_FREQUENCY_CAP_COUNT="1"
ALLOW_SELF_SEND_AFTER_APPROVAL="false"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# --- AI (optional) ----------------------------------------------------------
# Without a key the app uses deterministic templates. It never blocks.
# Set AI_PROVIDER="gemini" or AI_PROVIDER="anthropic" or "auto"
AI_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# --- Optional integrations (each degrades to explicit manual review) --------
PAGESPEED_API_KEY=""
GOOGLE_PLACES_API_KEY=""
META_ACCESS_TOKEN=""
LINKEDIN_ACCESS_TOKEN=""
YOUTUBE_API_KEY=""

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# --- Sending via Spacemail (Spaceship email hosting) ------------------------
# IMPORTANT: the Spaceship API manages domains and DNS. It CANNOT send email.
# Sending goes over SMTP to Spacemail; the API is used only to inspect the DNS
# records that make sending deliverable.
#
# Check readiness before switching EMAIL_PROVIDER to smtp:
#   npm run email:check -- --domain yourdomain.com --test-connection
# SMTP_HOST="mail.spacemail.com"
# SMTP_PORT="465"            # 465 implicit TLS, or 587 STARTTLS
# SMTP_USER="you@yourdomain.com"   # the FULL mailbox address
# SMTP_PASSWORD=""

# --- Spaceship API (domains and DNS only) -----------------------------------
# Both are required: the API authenticates with X-Api-Key and X-Api-Secret.
SPACESHIP_API_KEY=""
SPACESHIP_API_SECRET=""

# --- Google (optional) ------------------------------------------------------
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
